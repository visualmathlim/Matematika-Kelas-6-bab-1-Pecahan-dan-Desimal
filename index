            <div class="bg-slate-800/30 rounded-3xl p-6 md:p-10 border border-slate-700">
                <div class="space-y-6 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-1 before:bg-gradient-to-b before:from-brand-500 before:via-slate-700 before:to-slate-700">
                    
