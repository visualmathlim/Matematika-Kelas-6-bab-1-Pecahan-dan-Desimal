                        <div class="flex items-center justify-center w-10 h-10 rounded-full border-4 border-darkbase bg-slate-700 text-slate-400 shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
