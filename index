<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VisualMath Academy | Pecahan & Desimal</title>
    
    <!-- Google Fonts: Nunito for a friendly, kid-friendly look -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        nunito: ['Nunito', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            900: '#1e3a8a',
                        },
                        darkbase: '#0f172a', /* slate-900 */
                        pureblack: '#000000'
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Nunito', sans-serif; }
        
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }

        /* Animation for floating elements */
        .float-anim {
            animation: float 3s ease-in-out infinite;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
    </style>
</head>
<body class="bg-darkbase text-slate-200 antialiased selection:bg-brand-500 selection:text-white flex flex-col min-h-screen">

    <!-- HERO SECTION (Pure Black background to blend with Logo if it has a black BG) -->
    <header class="bg-pureblack relative overflow-hidden pt-12 pb-20 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
        <!-- Decorative background elements -->
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 opacity-20 pointer-events-none">
            <div class="absolute w-64 h-64 bg-brand-600 rounded-full blur-3xl -top-20 -left-20 mix-blend-screen"></div>
            <div class="absolute w-64 h-64 bg-purple-600 rounded-full blur-3xl top-20 -right-20 mix-blend-screen"></div>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto text-center flex flex-col items-center">
